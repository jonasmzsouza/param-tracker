{
  "name": "param-tracker",
  "version": "3.0.2",
  "description": "Universal JavaScript utility for tracking and preserving UTM parameters in links and forms — compatible with browsers, Node.js, and ES Modules.",
  "type": "module",
  "main": "dist/tracker.cjs.js",
  "module": "dist/tracker.esm.js",
  "browser": "dist/tracker.min.js",
  "unpkg": "dist/tracker.min.js",
  "jsdelivr": "dist/tracker.min.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/tracker.esm.js",
      "require": "./dist/tracker.cjs.js",
      "default": "./dist/tracker.min.js"
    }
  },
  "scripts": {
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "echo 'No tests configured yet.'",
    "preview": "rs-preview create",
    "preview:clean": "rs-preview remove",
    "compute-version": "rs-compute-version",
    "compute-version:ci": "rs-compute-version --ci --json",
    "compute-version:json": "rs-compute-version --json",
    "changelog": "rs-generate-changelog",
    "release-notes": "rs-generate-release-notes"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jonasmzsouza/param-tracker"
  },
  "keywords": [
    "utm",
    "tracker",
    "tracking",
    "forms",
    "links",
    "link-cleaner",
    "url-utils",
    "javascript",
    "browser",
    "frontend",
    "analytics",
    "seo",
    "esbuild",
    "browser",
    "esmodule",
    "commonjs",
    "amd",
    "nodejs",
    "no-jquery"
  ],
  "author": {
    "name": "Jonas Souza",
    "email": "jonasmzsouza@gmail.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jonasmzsouza/param-tracker/issues"
  },
  "devDependencies": {
    "esbuild": "^0.25.11",
    "eslint": "9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.0.0",
    "release-suite": "^3.0.0"
  }
}
